DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=postgres
DB_SCHEMA=checklist_app
# Opcional: URL PostgreSQL completa; quando definida, tem precedência sobre DB_*.
# DATABASE_URL=
# DB_POOL_MAX=10

HOST=0.0.0.0
PORT=7733
FRONTEND_ORIGIN=http://localhost:5173
# Segredo compartilhado com o dass_auth para validação do token JWT
JWT_SECRET=supersecretjwtkey12345
# URL raiz do dass_auth; o Checklist usa os contratos existentes /auth/me e /colaborador/:matricula.
DASS_AUTH_BASE_URL=http://localhost:2123
# Compatibilidade temporária para instalações antigas; prefira DASS_AUTH_BASE_URL.
DASS_COLABORADOR_BASE_URL=
# Matrícula do único administrador permitido a inicializar a allowlist vazia.
CHECKLIST_INITIAL_ADMIN_MATRICULA=
