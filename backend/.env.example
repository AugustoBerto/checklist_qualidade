DB_PASSWORD=postgres
DB_DATABASE=postgres
DB_SCHEMA=checklist_app

# Obrigatório para assinar e validar tokens da aplicação.
JWT_SECRET=substitua-por-um-segredo-forte

HOST=localhost
PORT=7733
FRONTEND_ORIGIN=http://localhost:5173
# URL direta do dass_auth para o adaptador temporário de login.
DASS_AUTH_BASE_URL=http://localhost:2400/auth
# Base da API de colaboradores do dass_auth, usada para validar novas matrículas.
DASS_COLABORADOR_BASE_URL=http://localhost:2400/colaborador
# Matrícula do único administrador permitido a inicializar a allowlist vazia.
CHECKLIST_INITIAL_ADMIN_MATRICULA=
