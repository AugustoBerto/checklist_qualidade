<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Relatório de Checklist</title>
    <style>
        /* Estilos CSS otimizados para PDF, sem interatividade */
        body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; color: #333; }
        .report-sheet { width: 100%; max-width: 800px; margin: auto; }
        .report-header { text-align: center; border-bottom: 2px solid #eee; padding-bottom: 1rem; margin-bottom: 1.5rem; }
        .logo { max-height: 50px; margin-bottom: 1rem; }
        h1 { font-size: 1.8rem; font-weight: 300; }
        .metadata { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem 2rem; margin-bottom: 2rem; }
        .score { font-size: 1.1rem; font-weight: bold; }
        .score span { color: #007bff; }
        .category-section { margin-bottom: 1.5rem; page-break-inside: avoid; }
        .category-title { background-color: #f8f9fa; padding: 0.75rem; border-radius: 4px; font-size: 1.2rem; border-left: 4px solid #007bff; }
        .answers-table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
        .answers-table tr { border-bottom: 1px solid #f1f3f5; }
        .answers-table td { padding: 0.5rem; }
        .question-text { width: 70%; }
        .answer-text { text-align: right; font-weight: bold; }
        .status-conforme { color: #28a745; }
        .status-nao-conforme { color: #dc3545; }
        .status-nao-preenchido { color: #fd7e14; }
        .status-na { color: #6c757d; }
        .report-footer { text-align: center; margin-top: 2rem; page-break-before: auto; }
        .signature-box { margin-top: 1rem; padding: 1rem; border: 1px solid #dee2e6; display: inline-block; }
        .signature-img { max-width: 250px; max-height: 100px; }
    </style>
</head>
<body>
    <div class="report-sheet">
        <header class="report-header">
            <h1>Relatório de Checklist de Liderança</h1>
        </header>

        <section class="metadata">
            <div><strong>Modelo:</strong> <%= relatorio.nomeModelo %></div>
            <div><strong>Usuário:</strong> <%= relatorio.nomeUsuario %></div>
            <div><strong>Data:</strong> <%= new Date(relatorio.dataEnvio).toLocaleString('pt-BR') %></div>
            <div class="score"><strong>Pontuação:</strong> <span><%= relatorio.pontuacao %>%</span></div>
        </section>

        <main class="report-body">
            <% for (const categoria in relatorio.categorias) { %>
                <div class="category-section">
                    <h2 class="category-title"><%= categoria %></h2>
                    <table class="answers-table">
                        <tbody>
                            <% relatorio.categorias[categoria].forEach(item => { %>
                                <tr>
                                    <td class="question-text"><%= item.pergunta %></td>
                                    <td class="answer-text status-<%= item.resposta.toLowerCase().replace(/ /g, '-').replace('ã','a') %>">
                                        <%= item.resposta %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </main>

        <footer class="report-footer">
            <h3>Assinatura do Responsável</h3>
            <div class="signature-box">
                <img src="<%= relatorio.assinatura %>" alt="Assinatura Digital" class="signature-img">
            </div>
        </footer>
    </div>
</body>
</html>